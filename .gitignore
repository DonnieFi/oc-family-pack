# Allowlist: plugin code, docs, planning (beads export, audit) and agent
# config are published. Local state and the beads database stay here.
/*
!/.gitignore
!/README.md
!/FAQ.md
!/LICENSE
!/package.json
!/pnpm-lock.yaml
!/package-lock.json
!/tsconfig.json
!/openclaw.plugin.json
!/index.ts
!/src/
!/assets/
!/skills/
!/AGENTS.md
!/fpack_audit.md
!/.agents/
!/.claude/
!/.codex/
!/.beads/

**/*.md
!/README.md
!/FAQ.md
!/skills/**/SKILL.md
!/AGENTS.md
!/fpack_audit.md
!/.agents/**/*.md
!/.beads/README.md

/.beads/backup/
/.beads/hooks/

node_modules/
dist/
coverage/
*.log
*.sqlite
*.sqlite-*
*.db
.env*
.DS_Store
**/fixtures/private/
**/*.local.*
