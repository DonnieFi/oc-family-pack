# Allowlist: plugin code, docs and agent config are published.
# Local state and the whole beads directory stay here.
/*
!/.gitignore
!/README.md
!/FAQ.md
!/HOUSEHOLD-LAN.md
!/SETUP.md
!/CHANGELOG.md
!/SECURITY.md
!/LICENSE
!/package.json
!/pnpm-lock.yaml
!/package-lock.json
!/tsconfig.json
!/tsconfig.build.json
!/tsconfig.scripts.json
!/openclaw.plugin.json
!/scripts/
!/src/
!/dist/
!/skills/
!/AGENTS.md
!/.agents/
!/.claude/
!/.codex/

**/*.md
!/README.md
!/SECURITY.md
!/FAQ.md
!/HOUSEHOLD-LAN.md
!/SETUP.md
!/CHANGELOG.md
!/skills/**/SKILL.md
!/AGENTS.md
!/.agents/**/*.md

/.beads/

# Planning, research, audits and proof artifacts: local only.
# The plan map (docs/overview.html) is public, served by GitHub Pages.
# docs/readme holds the demo renders embedded in README.md.
!/docs/
/docs/*
!/docs/overview.html
!/docs/readme/
!/docs/readme/*.png

node_modules/
coverage/
*.log
*.sqlite
*.sqlite-*
*.db
.env*
.DS_Store
**/fixtures/private/
**/*.local.*
