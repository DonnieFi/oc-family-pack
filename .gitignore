# Allowlist: plugin code, docs, the beads plan export, and agent
# config are published. Local state and the beads database stay here.
/*
!/.gitignore
!/README.md
!/FAQ.md
!/LICENSE
!/package.json
!/pnpm-lock.yaml
!/package-lock.json
!/tsconfig.json
!/tsconfig.build.json
!/tsconfig.scripts.json
!/openclaw.plugin.json
!/scripts/
!/src/
!/dist/
!/skills/
!/AGENTS.md
!/.agents/
!/.claude/
!/.codex/
!/.beads/

**/*.md
!/README.md
!/FAQ.md
!/skills/**/SKILL.md
!/AGENTS.md
!/.agents/**/*.md
!/.beads/README.md

/.beads/backup/
/.beads/hooks/

# Planning, research, audits and proof artifacts: local only.
# The plan map (docs/overview.html) is public, served by GitHub Pages.
!/docs/
/docs/*
!/docs/overview.html

node_modules/
coverage/
*.log
*.sqlite
*.sqlite-*
*.db
.env*
.DS_Store
**/fixtures/private/
**/*.local.*
