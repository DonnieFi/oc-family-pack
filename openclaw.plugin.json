{
  "id": "oc-family-pack",
  "name": "Family",
  "description": "A calm family week view in the Control UI: shared calendars, local weather, and quick chats with your agents.",
  "version": "0.1.0",
  "categories": [
    "scheduling"
  ],
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "activation": {
    "onStartup": true
  },
  "backupResources": [
    {
      "disposition": "include",
      "scope": "state",
      "relativePath": "plugins/oc-family-pack"
    }
  ],
  "configGroups": [
    {
      "id": "family-view",
      "title": "Family view",
      "order": 10,
      "properties": [
        "timezone",
        "demo"
      ]
    },
    {
      "id": "family-members",
      "title": "Members and calendars",
      "order": 20,
      "properties": [
        "members",
        "calendars",
        "gogPath"
      ]
    },
    {
      "id": "family-weather",
      "title": "Weather",
      "order": 30,
      "properties": [
        "location"
      ]
    }
  ],
  "uiHints": {
    "timezone": {
      "label": "Time zone",
      "placeholder": "America/Toronto",
      "help": "IANA time zone for the week view. Leave empty to use the Gateway host's time zone."
    },
    "demo": {
      "label": "Demo week",
      "help": "Show a synthetic week instead of real calendars."
    },
    "gogPath": {
      "label": "gog command",
      "placeholder": "gog"
    },
    "location": {
      "label": "Weather location",
      "help": "Environment Canada forecasts; Canada only."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "demo": {
        "type": "boolean",
        "default": false
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "location": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "gogPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "profileId",
            "displayName",
            "role"
          ],
          "properties": {
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "parent"
                },
                {
                  "type": "string",
                  "const": "kid"
                },
                {
                  "type": "string",
                  "const": "guest"
                }
              ]
            },
            "color": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^(?:#[0-9a-fA-F]{3,8}|(?:rgb|rgba|hsl|hsla|oklch|oklab)\\([0-9.,%\\s/-]+\\)|[a-zA-Z]+)$"
            },
            "discordId": {
              "type": "string",
              "minLength": 17,
              "maxLength": 20,
              "pattern": "^\\d{17,20}$"
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "primaryMac",
                  "source"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "primaryMac": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "aliasMacs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 32
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "calendars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "personal"
                },
                {
                  "type": "string",
                  "const": "shared"
                },
                {
                  "type": "string",
                  "const": "school"
                }
              ]
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 16
      }
    },
    "additionalProperties": false
  },
  "controlUi": {
    "entry": "dist/control-ui/c2f13ee5a89dae0efe7859b6b6d713930d936492375080db8f25d773b9c0db95/index.js",
    "styles": [
      "dist/control-ui/c2f13ee5a89dae0efe7859b6b6d713930d936492375080db8f25d773b9c0db95/index.css"
    ]
  },
  "contracts": {
    "tools": []
  }
}
