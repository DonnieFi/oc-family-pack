{
  "id": "oc-family-pack",
  "name": "Family",
  "description": "A calm family week view in the Control UI: shared calendars, local weather, and quick chats with your agents.",
  "version": "0.1.0",
  "categories": [
    "scheduling"
  ],
  "uiCapabilities": [
    "page",
    "navigation"
  ],
  "activation": {
    "onStartup": true
  },
  "backupResources": [
    {
      "disposition": "include",
      "scope": "state",
      "relativePath": "plugins/oc-family-pack"
    }
  ],
  "configGroups": [
    {
      "id": "family-view",
      "title": "Family view",
      "order": 10,
      "properties": [
        "timezone",
        "demo"
      ]
    },
    {
      "id": "family-members",
      "title": "Members and calendars",
      "order": 20,
      "properties": [
        "members",
        "calendars",
        "gogPath"
      ]
    },
    {
      "id": "family-weather",
      "title": "Weather",
      "order": 30,
      "properties": [
        "location"
      ]
    },
    {
      "id": "family-garbage",
      "title": "Garbage day",
      "order": 40,
      "properties": [
        "garbageIcsUrl"
      ]
    },
    {
      "id": "family-briefs",
      "title": "Daily and weekly briefs",
      "order": 50,
      "properties": [
        "channels",
        "summaryChannel"
      ]
    }
  ],
  "uiHints": {
    "timezone": {
      "label": "Time zone",
      "placeholder": "America/Toronto",
      "help": "IANA time zone for the week view. Leave empty to use the Gateway host's time zone."
    },
    "demo": {
      "label": "Demo week",
      "help": "Show a synthetic week instead of real calendars."
    },
    "gogPath": {
      "label": "gog command",
      "placeholder": "gog"
    },
    "location": {
      "label": "Weather location",
      "help": "Environment Canada forecasts; Canada only."
    },
    "garbageIcsUrl": {
      "label": "Garbage day calendar",
      "placeholder": "https://…/events.en.ics",
      "help": "Your city's collection calendar link (.ics), for example from ReCollect. Only curbside pickups are shown.",
      "sensitive": true
    },
    "channels": {
      "label": "Discord channels",
      "help": "A short name for each Discord channel Family posts to, with its channel id, such as family-briefs."
    },
    "summaryChannel": {
      "label": "Brief channel",
      "placeholder": "family-briefs",
      "help": "The channel name from Discord channels that gets the 7:00 AM daily brief and the Sunday 8:00 PM week ahead. Leave empty for no briefs. Channel reminders mention people here."
    },
    "reminderLeadMinutes": {
      "label": "Reminder lead times",
      "help": "Minutes before an event to remind the people who own that calendar. 15 if left empty. An empty list sends no reminders."
    },
    "quietHours": {
      "label": "Quiet hours",
      "help": "Hours in the household timezone when reminders wait. They go out when the window ends. 22:00 to 07:00 if left empty."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "demo": {
        "type": "boolean",
        "default": false
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "location": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "garbageIcsUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "channels": {
        "type": "object",
        "patternProperties": {
          "^[a-z0-9][a-z0-9-]{0,39}$": {
            "type": "string",
            "minLength": 17,
            "maxLength": 20,
            "pattern": "^\\d{17,20}$"
          }
        },
        "maxProperties": 20,
        "additionalProperties": false
      },
      "summaryChannel": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      },
      "reminderLeadMinutes": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "maxItems": 8,
        "default": [
          15
        ]
      },
      "quietHours": {
        "type": "object",
        "required": [
          "startHour",
          "endHour"
        ],
        "properties": {
          "startHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "default": 22
          },
          "endHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "default": 7
          }
        },
        "additionalProperties": false
      },
      "gogPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "writes": {
        "anyOf": [
          {
            "type": "string",
            "const": "on"
          },
          {
            "type": "string",
            "const": "confirm"
          },
          {
            "type": "string",
            "const": "off"
          }
        ],
        "default": "on"
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "profileId",
            "displayName",
            "role"
          ],
          "properties": {
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "parent"
                },
                {
                  "type": "string",
                  "const": "kid"
                },
                {
                  "type": "string",
                  "const": "guest"
                }
              ]
            },
            "color": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^(?:#[0-9a-fA-F]{3,8}|(?:rgb|rgba|hsl|hsla|oklch|oklab)\\([0-9.,%\\s/-]+\\)|[a-zA-Z]+)$"
            },
            "discordId": {
              "type": "string",
              "minLength": 17,
              "maxLength": 20,
              "pattern": "^\\d{17,20}$"
            },
            "reminders": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "dm"
                },
                {
                  "type": "string",
                  "const": "channel"
                },
                {
                  "type": "string",
                  "const": "off"
                }
              ],
              "default": "dm"
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "primaryMac",
                  "source"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "primaryMac": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "aliasMacs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 32
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "calendars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "personal"
                },
                {
                  "type": "string",
                  "const": "shared"
                },
                {
                  "type": "string",
                  "const": "school"
                }
              ]
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 16
      }
    },
    "additionalProperties": false
  },
  "controlUi": {
    "entry": "dist/control-ui/79dafa3a49c80dde76d868d9f7f74bb2bdbb99084a101a00b4c229d459f0faac/index.js",
    "styles": [
      "dist/control-ui/79dafa3a49c80dde76d868d9f7f74bb2bdbb99084a101a00b4c229d459f0faac/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "garbage_schedule",
      "family_schedule",
      "calendar_create",
      "calendar_update",
      "calendar_move",
      "calendar_delete",
      "set_reminder_mode"
    ]
  }
}
