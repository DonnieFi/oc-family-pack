{
  "id": "oc-family-pack",
  "name": "Family",
  "description": "A calm family week in the Control UI: shared calendars, today's highlights, weather, briefs, and chat with your agents.",
  "version": "0.2.0",
  "categories": [
    "scheduling"
  ],
  "uiCapabilities": [
    "page",
    "navigation",
    "widget"
  ],
  "skills": [
    "./skills"
  ],
  "cliCommands": [
    {
      "name": "family",
      "description": "Set up family calendars, members, and household access",
      "hasSubcommands": true
    }
  ],
  "activation": {
    "onStartup": true
  },
  "backupResources": [
    {
      "disposition": "include",
      "scope": "state",
      "relativePath": "plugins/oc-family-pack"
    }
  ],
  "configGroups": [
    {
      "id": "family-view",
      "title": "Family view",
      "order": 10,
      "properties": [
        "timezone",
        "demo"
      ]
    },
    {
      "id": "family-members",
      "title": "Members and calendars",
      "order": 20,
      "properties": [
        "members",
        "calendars",
        "gogPath"
      ]
    },
    {
      "id": "family-weather",
      "title": "Weather",
      "order": 30,
      "properties": [
        "location"
      ]
    },
    {
      "id": "family-garbage",
      "title": "Garbage day",
      "order": 40,
      "properties": [
        "garbageIcsUrl"
      ]
    },
    {
      "id": "family-briefs",
      "title": "Daily and weekly briefs",
      "order": 50,
      "properties": [
        "channels",
        "summaryChannel"
      ]
    }
  ],
  "uiHints": {
    "timezone": {
      "label": "Time zone",
      "placeholder": "America/Toronto",
      "help": "IANA time zone for the week view. Leave empty to use the Gateway host's time zone."
    },
    "demo": {
      "label": "Demo week",
      "help": "Show a synthetic week instead of real calendars."
    },
    "gogPath": {
      "label": "gog command",
      "placeholder": "gog"
    },
    "location": {
      "label": "Weather location",
      "help": "Environment Canada forecasts; Canada only."
    },
    "garbageIcsUrl": {
      "label": "Garbage day calendar",
      "placeholder": "https://…/events.en.ics",
      "help": "Your city's collection calendar link (.ics), for example from ReCollect. Only curbside pickups are shown.",
      "sensitive": true
    },
    "channels": {
      "label": "Discord channels",
      "help": "A short name for each Discord channel Family posts to, with its channel id, such as family-briefs."
    },
    "summaryChannel": {
      "label": "Brief channel",
      "placeholder": "family-briefs",
      "help": "The channel name from Discord channels that gets the 7:00 AM daily brief and the Sunday 8:00 PM week ahead. Leave empty for no briefs. Channel reminders mention people here."
    },
    "reminderLeadMinutes": {
      "label": "Reminder lead times",
      "help": "Minutes before an event to remind the people who own that calendar. 15 if left empty. An empty list sends no reminders."
    },
    "quietHours": {
      "label": "Quiet hours",
      "help": "Hours in the household timezone when reminders wait. They go out when the window ends. 22:00 to 07:00 if left empty."
    },
    "morningTime": {
      "label": "Morning brief",
      "placeholder": "07:00",
      "help": "Weekday time, 24-hour HH:MM, when parents get a direct message of today's and tomorrow's calendar items. Leave empty for no morning brief."
    },
    "afterSchoolTime": {
      "label": "After-school brief",
      "placeholder": "15:30",
      "help": "Weekday time, 24-hour HH:MM, when the brief channel gets the afternoon exceptions and pack list. Leave empty to skip it. A day that matches a closed-day phrase stays quiet."
    },
    "weekendPreviewTime": {
      "label": "Weekend preview",
      "placeholder": "16:00",
      "help": "Time, 24-hour HH:MM, when the brief channel gets the preview through Sunday. Leave empty to skip it."
    },
    "weekendPreviewWeekday": {
      "label": "Weekend preview day",
      "help": "Which day the preview goes out: 0 is Sunday through 6 is Saturday. Friday if left empty."
    },
    "schoolHints": {
      "label": "School phrases",
      "help": "Words that mark a school event, so the morning brief leaves it for the after-school post. Empty includes those events in the morning."
    },
    "closedDayPhrases": {
      "label": "Closed-day phrases",
      "help": "Words that mark a weekday closed, such as a day off school. The after-school post stays quiet. Empty means only weekends are quiet."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "demo": {
        "type": "boolean",
        "default": false
      },
      "timezone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "location": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "garbageIcsUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "channels": {
        "type": "object",
        "patternProperties": {
          "^[a-z0-9][a-z0-9-]{0,39}$": {
            "type": "string",
            "minLength": 17,
            "maxLength": 20,
            "pattern": "^\\d{17,20}$"
          }
        },
        "maxProperties": 20,
        "additionalProperties": false
      },
      "summaryChannel": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      },
      "reminderLeadMinutes": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "maxItems": 8,
        "default": [
          15
        ]
      },
      "quietHours": {
        "type": "object",
        "required": [
          "startHour",
          "endHour"
        ],
        "properties": {
          "startHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "default": 22
          },
          "endHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "default": 7
          }
        },
        "additionalProperties": false
      },
      "morningTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "afterSchoolTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "weekendPreviewTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "weekendPreviewWeekday": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "schoolHints": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "maxItems": 16
      },
      "closedDayPhrases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "maxItems": 16
      },
      "gogPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "writes": {
        "anyOf": [
          {
            "type": "string",
            "const": "on"
          },
          {
            "type": "string",
            "const": "confirm"
          },
          {
            "type": "string",
            "const": "off"
          }
        ],
        "default": "on"
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "profileId",
            "displayName",
            "role"
          ],
          "properties": {
            "profileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "parent"
                },
                {
                  "type": "string",
                  "const": "kid"
                },
                {
                  "type": "string",
                  "const": "guest"
                }
              ]
            },
            "color": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^(?:#[0-9a-fA-F]{3,8}|(?:rgb|rgba|hsl|hsla|oklch|oklab)\\([0-9.,%\\s/-]+\\)|[a-zA-Z]+)$"
            },
            "discordId": {
              "type": "string",
              "minLength": 17,
              "maxLength": 20,
              "pattern": "^\\d{17,20}$"
            },
            "reminders": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "dm"
                },
                {
                  "type": "string",
                  "const": "channel"
                },
                {
                  "type": "string",
                  "const": "off"
                }
              ],
              "default": "dm"
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "primaryMac",
                  "source"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "primaryMac": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "aliasMacs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 32
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "calendars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "label",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "personal"
                },
                {
                  "type": "string",
                  "const": "shared"
                },
                {
                  "type": "string",
                  "const": "school"
                }
              ]
            },
            "owners": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 32
            }
          },
          "additionalProperties": false
        },
        "maxItems": 16
      }
    },
    "additionalProperties": false
  },
  "controlUi": {
    "entry": "dist/control-ui/8618d8ab63eba868f0a6e0b96b1ab12d28ac3d31234ea06ec3299554522b7d38/index.js",
    "styles": [
      "dist/control-ui/8618d8ab63eba868f0a6e0b96b1ab12d28ac3d31234ea06ec3299554522b7d38/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "garbage_schedule",
      "family_schedule",
      "family_today",
      "calendar_create",
      "calendar_update",
      "calendar_move",
      "calendar_delete",
      "set_reminder_mode"
    ]
  }
}
